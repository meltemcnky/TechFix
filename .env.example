# TechFix Production Environment Variables
# Canlıya alırken (Vercel vb.) bu değişkene Medeniyet Teknopark özel domaininizi ekleyin.
# VITE_PUBLIC_APP_URL=https://techfix.medeniyetteknopark.com

# Supabase public client configuration.
# Use the DEV project values in .env.local and the corporate PRO values in
# Vercel Production. Never place service_role, database passwords, or access
# tokens in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only Supabase Edge Function secrets (never use a VITE_ prefix):
# ALLOWED_ORIGINS=https://techfix.medeniyetteknopark.com
# TECHNICIAN_GRANT_SECRET=generate-at-least-32-random-characters
